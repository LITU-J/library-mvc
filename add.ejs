<%- include('partials/header') %>

<h2>Add New Book</h2>

<% if (errors && errors.length) { %>
    <div class="error">
        <ul>
            <% errors.forEach(err => { %>
                <li><%= err %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<form action="/add" method="POST">
    <label>Title:</label><br>
    <input type="text" name="title" value="<%= formData.title || '' %>" required><br><br>

    <label>Author:</label><br>
    <input type="text" name="author" value="<%= formData.author || '' %>" required><br><br>

    <label>ISBN:</label><br>
    <input type="text" name="isbn" value="<%= formData.isbn || '' %>" required><br><br>

    <label>Quantity:</label><br>
    <input type="number" name="quantity" value="<%= formData.quantity || 1 %>"><br><br>

    <button type="submit">Add Book</button>
    <a href="/">Cancel</a>
</form>

<%- include('partials/footer') %>
