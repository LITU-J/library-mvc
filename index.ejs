<%- include('partials/header') %>

<h2>Book Catalog</h2>

<% if (books.length === 0) { %>
    <p>No books in the library. <a href="/add">Add one now</a>.</p>
<% } else { %>
    <table border="1" cellpadding="10" cellspacing="0">
        <thead>
            <tr><th>ID</th><th>Title</th><th>Author</th><th>ISBN</th><th>Qty</th><th>Actions</th></tr>
        </thead>
        <tbody>
            <% books.forEach(book => { %>
                <tr>
                    <td><%= book.id %></td>
                    <td><%= book.title %></td>
                    <td><%= book.author %></td>
                    <td><%= book.isbn %></td>
                    <td><%= book.quantity %></td>
                    <td>
                        <a href="/edit/<%= book.id %>">Edit</a>
                        <form action="/delete/<%= book.id %>" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Delete this book?')">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('partials/footer') %>
